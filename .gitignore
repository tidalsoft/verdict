# This module is a pure library with no binaries, so there is no /bin or
# /dist to ignore -- see gatepost's .gitignore for the equivalent when this
# module had a cmd/ carve-out.

# Coverage output (make cover). Scoped to the coverage/ directory rather
# than a bare *.out / *.prof glob, so that any future testdata/*.out golden
# fixtures are not silently untracked by an over-broad pattern.
/coverage/*.out
/coverage/*.prof

# Orchestrator state (Sisyphus/Prometheus plans, drafts, evidence, notepads).
# Never committed.
.sisyphus/

# OS
.DS_Store

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
